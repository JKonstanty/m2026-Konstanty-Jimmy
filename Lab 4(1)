#include <avr/io.h>
#define FREQ_CLK 1000000 //clock freq

void wait(volatile int);
void LEDstate(char new_state);

int main(void)
{
	int numberofstates = 22;
	char pattern[] = {'A','C','B','C','A','C','A','D','A','D','B','C','B','C','A','D','B','C','B','C','B','E'};
	DDRD = 0b00000000; //Pins are inputs 
	DDRC = 0b00000011; // Pins PC0 and PC1 are outputs
	PORTC = 0b00000011; //Turns off LEDS 
	
	while (PIND & 0b00000100) //program stay in loop if PD2 is high - does nothing and exits when switch is pressed
	{
	}
	
	while(1)
	{
		for (int i=0; i<numberofstates; i++) //REpeatedly display LED pattern and "scroll through states"
		{
			LEDstate(pattern[i]); //pass the current pattern state to the function to change to new state
		}
	}
	return 0;
}

void LEDstate(char new_state)
{
	//Changes LED states to new state defined by passed argument
	switch (new_state)
	{
		case 'A':
			PORTC = 0b00000000;
			wait(200);
		break;
		case 'B':
			PORTC = 0b00000000;
			wait(600);
		break;
		case 'C':
			PORTC = 0b00000011;
			wait(200);
		break;
		case 'D':
			PORTC = 0b00000011;
			wait(600);
		break;
		default:
			PORTC = 0b00000011;
			wait(2000);
		break;
	}//end switch
	
	while (!(PIND & 0b00000100)) //stay in loop if pin PD2 is low (pressed) pausing the LED pattern
	{
		wait(50);
	}
} //end change LED state

void wait(volatile int number_of_msec) {
	// This subroutine uses the Timer1 registers to create a delay equal to number_of_msec*T, where T is 1 msec
	// It changes depending on the frequency defined by FREQ_CLK
	char register_B_setting;
	char count_limit;
	
	// Some typical clock frequencies:
	switch(FREQ_CLK) {
		case 16000000:
		register_B_setting = 0b00000011; // this will start the timer in Normal mode with prescaler of 64 (CS02 = 0, CS01 = CS00 = 1).
		count_limit = 250; // For prescaler of 64, a count of 250 will require 1 msec
		break;
		case 8000000:
		register_B_setting =  0b00000011; // this will start the timer in Normal mode with prescaler of 64 (CS02 = 0, CS01 = CS00 = 1).
		count_limit = 125; // for prescaler of 64, a count of 125 will require 1 msec
		break;
		case 1000000:
		register_B_setting = 0b00000010; // this will start the timer in Normal mode with prescaler of 8 (CS02 = 0, CS01 = 1, CS00 = 0).
		count_limit = 125; // for prescaler of 8, a count of 125 will require 1 msec
		break;
	}
	
	while (number_of_msec > 0) {
		TCCR1A = 0x00; // clears WGM00 and WGM01 (bits 0 and 1) to ensure Timer/Counter is in normal mode.
		TCNT1 = 0;  // preload value for testing on count = 250
		TCCR1B =  register_B_setting;  // Start TIMER0 with the settings defined above
		while (TCNT1 < count_limit); // exits when count = the required limit for a 1 msec delay
		TCCR1B = 0x00; // Stop TIMER0
		number_of_msec--;
	}
} // end wait()
	
