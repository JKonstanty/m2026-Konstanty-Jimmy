#include <avr/io.h>
#include <avr/interrupt.h>

#define FREQ_CLK 1000000 //clock freq


//*Variable*//

void wait(volatile int);
void LEDstate(char new_state);
volatile int state = 0;

int numberofstates = 6;
char pattern[] = {'A','B','C','D','E','F'}; //This will be the order of turning on LEDs where A = LED '0' and B = LED '1' and so on
	
	
int main(void) 
{
	DDRD = 0b00000000; //Pins are inputs
	PORTD = 0b00001100; // Sets Pins PD2 and PD3 
	DDRC = 0b00111111; // Pins PC0 - PC5 are outputs
	PORTC = 0b00111111; //Turns off LEDS PC0-PC5
	DDRB = 0b00000011; // Pins PB0 and PB1 are outputs
	PORTB = 0b00000011; //Outputs PB0 and PB1 are off
	
	
	//Set Up Interrupts
	EICRA = 0b00001010; //Sets Trigger INT1 and INT0 to both be falling edges
	EIMSK = 0b00000011; //Enable INT0 and INT1
	sei(); //Enables Global Interrupt
	
	//States: State 0 - LEDS go through all 6; State 1 - LEDS go from 3-5
	
	
	while(1)
	{
		if (state == 0)
		{
			for (int i=0; i<numberofstates; i++) //Repeatedly display LED pattern and "scroll through states"
			{
				LEDstate(pattern[i]); //pass the current pattern state to the function to change to new state
				if (state != 0) 
				break;
			}
		}
		else if (state == 1)
		{
			PORTB = 0b00000001;
			for (int i=3; i<numberofstates; i++)
			{
				LEDstate(pattern[i]);
				if (state !=1)
				break;
			}	
		}
		else if (state == 2)
		{
			PORTC = 0b00111111; //TURN EM OFF (LEDS 0-5)
			PORTB = 0b0000000; //Turn on LED 7 and 6
		
			wait(3000);
			
			PORTB = 0b00000011; //Turn off LEDS 6 and 7
			state = 0;
		}
	}
	
	return 0;
}

void LEDstate(char new_state)
{
	//Changes LED states to new state defined by passed argument
	switch (new_state)
	{
		case 'A':
		PORTC = 0b00111110;
		wait(400);
		break;
		case 'B':
		PORTC = 0b00111101;
		wait(400);
		break;
		case 'C':
		PORTC = 0b00111011;
		wait(400);
		break;
		case 'D':
		PORTC = 0b00110111;
		wait(400);
		break;
		case 'E':
		PORTC = 0b00101111;
		wait(400);
		break;
		case 'F':
		PORTC = 0b00011111;
		wait(400);
		break;
	}//end switch
} //end change LED state


