ISR(INT1_vect)	
{
	//Code for ISR INT1
	//If Switch '1' is pressed while LED 5 (PC5) is on, turn LED 7 on and hold for 3 seconds
	wait(50);
	
	if(!(PIND & 0b00001000))
	{
		if (state == 1 && !(PORTC & 0b00100000))
		{
